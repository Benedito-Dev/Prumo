# Imagem de desenvolvimento do BackEnd (hot-reload via node --watch).
# O código-fonte é montado por volume no compose; aqui só instalamos deps.
FROM node:22-alpine

WORKDIR /app

# Instala dependências primeiro (aproveita cache do Docker)
COPY package*.json ./
RUN npm install

# O código real vem por volume (bind mount) no docker-compose.
EXPOSE 3000

CMD ["npm", "run", "dev"]
