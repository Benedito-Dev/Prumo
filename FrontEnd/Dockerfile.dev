# Imagem de desenvolvimento do FrontEnd (Vite com hot-reload).
# O código-fonte é montado por volume no compose; aqui só instalamos deps.
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

EXPOSE 5173

# --host expõe o Vite fora do container (0.0.0.0)
CMD ["npm", "run", "dev", "--", "--host"]
